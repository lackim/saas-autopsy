{
  "name": "saas-autopsy",
  "version": "0.2.0",
  "description": "Post-mortem analysis of SaaS startups — find out if a startup is alive, declining, or dead",
  "type": "module",
  "bin": {
    "saas-autopsy": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cli",
    "saas",
    "startup",
    "revenue",
    "analysis",
    "trustmrr",
    "shipcli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/set-executable.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm web:build",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "web:build": "pnpm --dir web build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "license": "MIT",
  "homepage": "https://github.com/lackim/saas-autopsy#readme",
  "bugs": {
    "url": "https://github.com/lackim/saas-autopsy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lackim/saas-autopsy.git"
  },
  "dependencies": {
    "@shipcli/core": "^0.4.1",
    "@shipcli/share": "^0.4.1",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@shipcli/cli": "^0.4.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
